# SPDX-License-Identifier: GPL-2.0
#
# Build configuration for the realme GT Neo 3 (lisaa), MT6895, Android 12.
# Sourced by build.sh; no AOSP build environment is required.
#
# The defconfig is assembled from the same fragments the stock ROM build uses:
# GKI base + MediaTek platform + OPPO/realme feature options.

DEFCONFIG_FRAGMENTS="
arch/arm64/configs/gki_defconfig
arch/arm64/configs/mgk_64_k510_defconfig
kernel/configs/oplus6895.config
"

# Extra flags applied to every translation unit.
KCFLAGS_EXTRA="-D__ANDROID_COMMON_KERNEL__"

# AOSP KMI identity, embedded in the kernel release string
# (5.10.209-android12-9-o-g<hash>).
export BRANCH=android12-5.10
export KMI_GENERATION=9

# ThinLTO is what the stock kernel uses.
LTO=thin

# Kernel image, in-tree modules and the device tree.
MAKE_GOALS="
Image.gz
modules
mediatek/mt6895.dtb
"

# Artifacts copied to out/dist (flattened, like build/build.sh does).
FILES="
arch/arm64/boot/Image.gz
arch/arm64/boot/dts/mediatek/mt6895.dtb
vmlinux
System.map
vmlinux.symvers
modules.builtin
modules.builtin.modinfo
"

# ---------------------------------------------------------------------------
# Platform environment used by the MediaTek / OPPO module Makefiles.
# These are exported to make; they select the chip variant, connectivity
# firmware flavour and board platform, exactly like the stock build does.
# ---------------------------------------------------------------------------

export TARGET_BUILD_VARIANT=user

export BT_PLATFORM=6895
export LOG_TAG='[BT_Drv][btif]'
export BUILD_CONNAC2=true
export CFG_BUILD_CONNAC2=true
export CFG_FM_CHIP=mt6635
export CFG_FM_PLAT=connac2x
export FM_CHIP=mt6635
export FM_PLAT=connac2x
export CONFIG_MTK_COMBO_WIFI_HIF=axi
export CONNAC_VER=2_0
export MTK_ANDROID_EMI=y
export MTK_ANDROID_WMT=y
export MTK_COMBO_CHIP=CONNAC2X2_SOC7_0
export MTK_WLAN_SERVICE=yes
export WIFI_IP_SET=1
export WLAN_CHIP_ID=6895
export CHIPSET_COMPANY=MTK
export MTK_PLATFORM=mt6895
export TARGET_BOARD_PLATFORM=mt6895

# Out-of-tree modules, relative to this directory. They are built with
# KERNEL_SRC=<this tree> and installed into the same staging directory as the
# in-tree modules.
EXT_MODULES="
vendor/mediatek/kernel_modules/connectivity/common
vendor/mediatek/kernel_modules/connectivity/connfem
vendor/mediatek/kernel_modules/connectivity/conninfra
vendor/mediatek/kernel_modules/connectivity/bt/mt66xx/btif
vendor/mediatek/kernel_modules/connectivity/fmradio
vendor/mediatek/kernel_modules/connectivity/gps/data_link/plat/v050
vendor/mediatek/kernel_modules/connectivity/gps/gps_pwr
vendor/mediatek/kernel_modules/connectivity/gps/gps_scp
vendor/mediatek/kernel_modules/connectivity/wlan/adaptor
vendor/mediatek/kernel_modules/connectivity/wlan/core/gen4m
vendor/mediatek/kernel_modules/fpsgo_cus
vendor/mediatek/kernel_modules/msync2_frd_cus
vendor/mediatek/kernel_modules/gpu
vendor/mediatek/kernel_modules/met_drv_v3
vendor/oplus/kernel/power/power_diag
vendor/oplus/kernel/explorer
vendor/oplus/kernel/cpu/game_opt
vendor/oplus/kernel/cpu/sched/task_cpustats
vendor/oplus/kernel/cpu/thermal/horae_shell_temp
vendor/oplus/kernel/cpu/thermal/oplus_ipa_thermal
vendor/oplus/secure/common/bsp/drivers/oplus_secure_common
vendor/oplus/kernel/nfc/sn_nci/nfc
vendor/oplus/kernel/nfc/sn_nci/ese
vendor/oplus/kernel/mm/gloom
vendor/oplus/kernel/mm/memleak_detect
vendor/oplus/kernel/network/oplus_score
vendor/oplus/kernel/network/oplus_dns_hook
vendor/oplus/kernel/network/oplus_qr_scan
vendor/oplus/kernel/network/oplus_stats_calc
vendor/oplus/kernel/network/linkpower_module
vendor/oplus/kernel/network/oplus_apps_monitor
vendor/oplus/kernel/network/oplus_game_first
vendor/oplus/kernel/network/oplus_network_tuning
vendor/oplus/kernel/network/oplus_socket_stats_report
vendor/oplus/kernel/network/oplus_vnet
vendor/oplus/kernel/network/data_module
vendor/oplus/kernel/secureguard/gki2.0/rootguard
vendor/oplus/kernel/framework_stability/oplus_stability_helper
vendor/oplus/sensor/kernel/sensorhub/pseudo-sensor
"
